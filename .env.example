# База CSFloat-бота, открывается только на чтение.
CSFLOAT_DB_PATH=/root/csfloatpricesparcing/data/csfloat_sales.db
# Секунд между запросами к BuffMarket.
BUFF_MIN_INTERVAL=5

# Сессия одного аккаунта BuffMarket (без входа сайт отвечает Login Required).
# Из браузера, где вы вошли: DevTools -> Network -> запрос sell_order ->
# Request Headers. Значения сюда, в .env с правами 600, и никуда больше.
BUFF_COOKIE=
BUFF_CSRF=
BUFF_USER_AGENT=
